#Область ПрограммныйИнтерфейс

// Транспорт только принимает готовый CFE. Исходники EDT/XML и произвольный BSL не исполняются.
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Для Каждого Имя Из СтрРазделить("extension_inspect,extension_validate,extension_install", ",") Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("name", "string", "Точное внутреннее имя расширения.", , Истина));
		Если Имя <> "extension_inspect" Тогда
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("cfe_base64", "string", "Готовый CFE, Base64; максимум 16 MiB после декодирования.", , Истина));
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("sha256", "string", "SHA256 передаваемых байтов CFE, 64 шестнадцатеричных символа.", , Истина));
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("expected_stand", "string", "stand_fingerprint заранее согласованной тестовой ИБ.", , Истина));
		КонецЕсли;
		Если Имя = "extension_install" Тогда
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("expected_previous_sha256", "string", "SHA256 сохраненного CFE; пустая строка требует отсутствия расширения.", , Истина));
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("confirm", "boolean", "Явный допуск этой установки. Только true.", , Истина));
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("safe_mode", "boolean", "Явная настройка безопасного режима устанавливаемого расширения. Отсутствие сохраняет значение платформы."));
			Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента("dangerous_actions_protection", "boolean", "Явная настройка предупреждений об опасных действиях устанавливаемого расширения. Отсутствие сохраняет значение платформы."));
		КонецЕсли;
		Схема = mcp_ОбщегоНазначения.JSONВСтруктуру(mcp_Метаданные.СхемаПараметровИнструмента(Параметры));
		Схема.Вставить("additionalProperties", Ложь);
		Схема.properties.name.Вставить("minLength", 1);
		Схема.properties.name.Вставить("maxLength", 128);
		Описание = "Инспекция сохраненного CFE и расширения, подключенного в текущем серверном сеансе. Без записи.";
		Если Имя = "extension_validate" Тогда
			Описание = "Проверка имени, SHA256, стенда и применимости CFE без установки.";
		ИначеЕсли Имя = "extension_install" Тогда
			Описание = "Установка CFE на явно разрешенном стенде с резервной копией. Требует свободной ИБ; чужие сеансы не завершает. "
				+ "status=stored не подтверждает применение в новом сеансе. После потери HTTP-ответа сначала extension_inspect, не автоматический повтор.";
		КонецЕсли;
		mcp_Метаданные.ДобавитьИнструмент(Инструменты, Имя, Описание, mcp_ОбщегоНазначения.СтруктураВJSON(Схема));
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	УстановкаВызвана = Ложь;
	ЭтапУстановки = "not_started";
	Попытка
		Если Не РольДоступна("mcp_ЧтениеРасширений") И Не РольДоступна("mcp_УстановкаРасширений") Тогда
			Возврат Ошибка("role_required", "Требуется роль чтения или установки расширений.", Идентификатор);
		КонецЕсли;
		ПроверитьАргументы(ИмяИнструмента, Аргументы);
		Если ИмяИнструмента = "extension_inspect" Тогда
			Возврат Ответ(Инспекция(Аргументы.name));
		КонецЕсли;
		Данные = ПроверитьПакет(Аргументы);
		Если ИмяИнструмента = "extension_validate" Тогда
			Результат = Инспекция(Аргументы.name);
			Результат.Вставить("artifact_sha256", SHA256(Данные));
			Кандидат = РасширенияКонфигурации.Создать(Данные);
			Результат.Вставить("artifact_platform_hash", Строка(Кандидат.ХешСумма));
			Результат.Вставить("changes_data_structure", Кандидат.ИзменяетСтруктуруДанных());
			Результат.Вставить("problems", ПроблемыПрименения(Аргументы.name, Данные));
			Результат.Вставить("applicable", Результат.problems.Количество() = 0);
			Результат.Вставить("status", "validated");
			Возврат Ответ(Результат);
		КонецЕсли;
		УстановкаВызвана = Истина;
		Возврат Установить(Аргументы, Данные, Идентификатор, ЭтапУстановки);
	Исключение
		Если УстановкаВызвана Тогда
			Возврат Ответ(Новый Структура("operation_id, status, error_code, message, failure_stage", Идентификатор,
				"unknown", "write_outcome_unknown", "Необработанная ошибка установки; сначала инспекция, не автоматический повтор.",
				ЭтапУстановки), Истина);
		КонецЕсли;
		Возврат Ошибка("validation_failed", Лев(ОписаниеОшибки(), 2048), Идентификатор);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьАргументы(ИмяИнструмента, Аргументы)

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		ВызватьИсключение "Аргументы должны быть JSON-объектом.";
	КонецЕсли;
	Допустимые = "name";
	Если ИмяИнструмента = "extension_validate" Или ИмяИнструмента = "extension_install" Тогда
		Допустимые = Допустимые + ",cfe_base64,sha256,expected_stand";
	ИначеЕсли ИмяИнструмента <> "extension_inspect" Тогда
		ВызватьИсключение "Неизвестный инструмент.";
	КонецЕсли;
	Если ИмяИнструмента = "extension_install" Тогда
		Допустимые = Допустимые + ",expected_previous_sha256,confirm";
	КонецЕсли;
	Имена = СтрРазделить(Допустимые, ",");
	Для Каждого Имя Из Имена Цикл
		Значение = Неопределено;
		Если Не Аргументы.Свойство(Имя, Значение) Тогда
			ВызватьИсключение "Не заполнен обязательный параметр: " + Имя;
		КонецЕсли;
		Если Имя = "confirm" Тогда
			Если ТипЗнч(Значение) <> Тип("Булево") Или Значение <> Истина Тогда
				ВызватьИсключение "confirm должен быть true.";
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
			ВызватьИсключение "Параметр должен быть строкой: " + Имя;
		КонецЕсли;
	КонецЦикла;
	Если ИмяИнструмента = "extension_install" Тогда
		Для Каждого ИмяНастройки Из СтрРазделить("safe_mode,dangerous_actions_protection", ",") Цикл
			Имена.Добавить(ИмяНастройки);
			Настройка = Неопределено;
			Если Аргументы.Свойство(ИмяНастройки, Настройка) И ТипЗнч(Настройка) <> Тип("Булево") Тогда
				ВызватьИсключение "Необязательная настройка должна быть boolean: " + ИмяНастройки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Аргумент Из Аргументы Цикл
		Если Имена.Найти(Аргумент.Ключ) = Неопределено Тогда
			ВызватьИсключение "Неизвестный параметр: " + Аргумент.Ключ;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Аргументы.name) Или СтрДлина(Аргументы.name) > 128 Тогда
		ВызватьИсключение "Недопустимое имя расширения.";
	КонецЕсли;
	Если ИмяИнструмента <> "extension_inspect" Тогда
		ПроверитьХеш(Аргументы.sha256);
		ПроверитьХеш(Аргументы.expected_stand);
	КонецЕсли;
	Если ИмяИнструмента = "extension_install" И Аргументы.expected_previous_sha256 <> "" Тогда
		ПроверитьХеш(Аргументы.expected_previous_sha256);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьХеш(Значение)

	Если СтрДлина(Значение) <> 64 Тогда
		ВызватьИсключение "SHA256 должен содержать 64 шестнадцатеричных символа.";
	КонецЕсли;
	Для Индекс = 1 По 64 Цикл
		Если СтрНайти("0123456789abcdef", НРег(Сред(Значение, Индекс, 1))) = 0 Тогда
			ВызватьИсключение "Недопустимый SHA256.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПроверитьПакет(Аргументы)

	Если НРег(Аргументы.expected_stand) <> ОтпечатокБазы() Тогда
		ВызватьИсключение "stand_mismatch: адрес текущей ИБ не совпадает с ожидаемым стендом.";
	КонецЕсли;
	Если СтрДлина(Аргументы.cfe_base64) > 22369624 Или ПустаяСтрока(Аргументы.cfe_base64) Тогда
		ВызватьИсключение "Размер Base64 превышает предел CFE 16 MiB или пакет пуст.";
	КонецЕсли;
	Данные = Base64Значение(Аргументы.cfe_base64);
	Если Данные.Размер() = 0 Или Данные.Размер() > 16777216 Тогда
		ВызватьИсключение "Размер CFE должен быть от 1 байта до 16 MiB.";
	КонецЕсли;
	Если SHA256(Данные) <> НРег(Аргументы.sha256) Тогда
		ВызватьИсключение "artifact_hash_mismatch: SHA256 пакета не совпадает.";
	КонецЕсли;
	// Создать(Данные) читает CFE в памяти, не устанавливая его в ИБ (платформа 8.3.22+).
	Описание = РасширенияКонфигурации.Создать(Данные);
	Если Описание.Имя <> Аргументы.name Тогда
		ВызватьИсключение "extension_name_mismatch: имя внутри CFE не совпадает.";
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция НайтиРасширение(Имя, Источник = Неопределено)

	Если Источник = Неопределено Тогда
		Список = РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя));
	Иначе
		Список = РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя), Источник);
	КонецЕсли;
	Если Список.Количество() > 1 Тогда
		ВызватьИсключение "Имя расширения неоднозначно в текущей области данных.";
	КонецЕсли;
	Возврат ?(Список.Количество() = 0, Неопределено, Список[0]);

КонецФункции

Функция Инспекция(Имя)

	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("name, stand_fingerprint, platform_version, configuration_version, current_user",
		Имя, ОтпечатокБазы(), Информация.ВерсияПриложения, Метаданные.Версия, ИмяПользователя());
	Результат.Вставить("configuration_name", Метаданные.Имя);
	Результат.Вставить("session_id", Строка(НомерСеансаИнформационнойБазы()));
	Результат.Вставить("exists", Ложь);
	Результат.Вставить("enabled", Ложь);
	Результат.Вставить("safe_mode", Неопределено);
	Результат.Вставить("dangerous_actions_protection", Неопределено);
	Результат.Вставить("session_safe_mode", Неопределено);
	Результат.Вставить("session_dangerous_actions_protection", Неопределено);
	Результат.Вставить("stored_sha256", "");
	Результат.Вставить("stored_platform_hash", "");
	Результат.Вставить("session_platform_hash", "");
	Результат.Вставить("applied_in_current_session", Ложь);
	Результат.Вставить("installation_enabled", Константы.mcp_УстановкаРасширенийРазрешена.Получить());
	Расширение = НайтиРасширение(Имя);
	Если Расширение <> Неопределено Тогда
		Результат.exists = Истина;
		Результат.enabled = Расширение.Активно;
		Результат.safe_mode = Расширение.БезопасныйРежим;
		Результат.dangerous_actions_protection = Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		Результат.stored_sha256 = SHA256(Расширение.ПолучитьДанные());
		Результат.stored_platform_hash = Строка(Расширение.ХешСумма);
	КонецЕсли;
	Подключенное = НайтиРасширение(Имя, ИсточникРасширенийКонфигурации.СеансАктивные);
	Если Подключенное <> Неопределено Тогда
		Результат.session_platform_hash = Строка(Подключенное.ХешСумма);
		Результат.session_safe_mode = Подключенное.БезопасныйРежим;
		Результат.session_dangerous_actions_protection = Подключенное.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		Результат.applied_in_current_session = Результат.exists И Результат.enabled
			И Результат.session_platform_hash = Результат.stored_platform_hash
			И Результат.session_safe_mode = Результат.safe_mode
			И Результат.session_dangerous_actions_protection = Результат.dangerous_actions_protection;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПроблемыПрименения(Имя, Данные)

	Расширение = НайтиРасширение(Имя);
	Если Расширение = Неопределено Тогда
		Расширение = РасширенияКонфигурации.Создать();
	КонецЕсли;
	Проблемы = Новый Массив;
	Для Каждого Проблема Из Расширение.ПроверитьВозможностьПрименения(Данные, Ложь) Цикл
		Проблемы.Добавить(Новый Структура("severity, description", Строка(Проблема.Важность), Проблема.Описание));
	КонецЦикла;
	Возврат Проблемы;

КонецФункции

Функция Установить(Аргументы, Данные, Идентификатор, ЭтапУстановки)

	ЭтапУстановки = "role_check";
	Если Не РольДоступна("mcp_УстановкаРасширений") Тогда
		Возврат Ошибка("install_role_required", "Требуется отдельная роль установки расширений.", Идентификатор);
	КонецЕсли;
	ЭтапУстановки = "policy_check";
	Если Не Константы.mcp_УстановкаРасширенийРазрешена.Получить()
		Или НРег(Константы.mcp_СтендУстановкиРасширений.Получить()) <> ОтпечатокБазы() Тогда
		Возврат Ошибка("installation_disabled", "Серверный допуск установки на этот стенд не настроен.", Идентификатор);
	КонецЕсли;
	ЭтапУстановки = "context_check";
	Если ТранзакцияАктивна() Или МонопольныйРежим() Тогда
		Возврат Ошибка("context_busy", "Установка требует отдельного сеанса вне транзакции и чужого монопольного режима.", Идентификатор);
	КонецЕсли;
	ЭтапУстановки = "backup_directory_check";
	Попытка
		Каталог = Константы.mcp_КаталогКопийРасширений.Получить();
		ФайлКаталога = Новый Файл(Каталог);
		Если ПустаяСтрока(Каталог) Или Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
			Возврат Ошибка("backup_directory_unavailable", "Администратор должен настроить существующий каталог резервных CFE.", Идентификатор);
		КонецЕсли;
	Исключение
		// Здесь ещё не запрашивались монопольный режим и запись CFE.
		// Системный текст ошибки может содержать приватный путь и в HTTP не включается.
		Возврат Ошибка("backup_directory_unavailable",
			"Каталог копий недоступен. Проверьте права сервиса и безопасный режим самого MCP-расширения.", Идентификатор);
	КонецПопытки;
	ЭтапУстановки = "exclusive_acquire";
	Попытка
		УстановитьМонопольныйРежим(Истина);
	Исключение
		Возврат Ошибка("exclusive_access_required", "ИБ занята. Чужие сеансы не завершались, расширение не записано.", Идентификатор);
	КонецПопытки;
	ЗаписьНачата = Ложь;
	ПутьКопии = "";
	ХешКопии = "";
	ЭтапУстановки = "exclusive_body";
	Попытка
		Если Не Константы.mcp_УстановкаРасширенийРазрешена.Получить()
			Или НРег(Константы.mcp_СтендУстановкиРасширений.Получить()) <> ОтпечатокБазы()
			Или Каталог <> Константы.mcp_КаталогКопийРасширений.Получить() Тогда
			ВызватьИсключение "policy_changed: серверный допуск изменился до получения монопольного доступа.";
		КонецЕсли;
		ДоУстановки = Инспекция(Аргументы.name);
		Если ДоУстановки.stored_sha256 <> НРег(Аргументы.expected_previous_sha256) Тогда
			ВызватьИсключение "previous_hash_mismatch: состояние расширения изменилось. Повторите инспекцию.";
		КонецЕсли;
		Проблемы = ПроблемыПрименения(Аргументы.name, Данные);
		// Первая версия не принимает даже предупреждения без отдельного анализа.
		Если Проблемы.Количество() > 0 Тогда
			ВызватьИсключение "applicability_failed: есть проблемы применимости; сначала extension_validate.";
		КонецЕсли;
		Расширение = НайтиРасширение(Аргументы.name);
		Если Расширение <> Неопределено Тогда
			ДанныеКопии = Расширение.ПолучитьДанные();
			ХешКопии = SHA256(ДанныеКопии);
			ПутьКопии = Каталог + ПолучитьРазделительПути() + Идентификатор + ".cfe";
			ДанныеКопии.Записать(ПутьКопии);
			Если SHA256(Новый ДвоичныеДанные(ПутьКопии)) <> ХешКопии Тогда
				ВызватьИсключение "backup_verification_failed: резервная копия не подтверждена.";
			КонецЕсли;
		Иначе
			Расширение = РасширенияКонфигурации.Создать();
		КонецЕсли;
		// Меняются только явно переданные свойства конкретного расширения.
		// Пользовательская и глобальная защита платформы не изменяются.
		Настройка = Неопределено;
		Если Аргументы.Свойство("safe_mode", Настройка) Тогда
			Расширение.БезопасныйРежим = Настройка;
		КонецЕсли;
		Если Аргументы.Свойство("dangerous_actions_protection", Настройка) Тогда
			Защита = Расширение.ЗащитаОтОпасныхДействий;
			Защита.ПредупреждатьОбОпасныхДействиях = Настройка;
			Расширение.ЗащитаОтОпасныхДействий = Защита;
		КонецЕсли;
		Аудит(Идентификатор, "write_started", Аргументы.name, Аргументы.sha256);
		ЗаписьНачата = Истина;
		Расширение.Записать(Данные);
		Результат = Инспекция(Аргументы.name);
		Кандидат = РасширенияКонфигурации.Создать(Данные);
		Если Не Результат.exists Или Результат.stored_platform_hash <> Строка(Кандидат.ХешСумма) Тогда
			ВызватьИсключение "stored_hash_mismatch: после записи не подтвержден хеш содержимого расширения.";
		КонецЕсли;
		Результат.Вставить("operation_id", Идентификатор);
		Результат.Вставить("status", "stored");
		Результат.Вставить("artifact_sha256", НРег(Аргументы.sha256));
		Результат.Вставить("artifact_platform_hash", Строка(Кандидат.ХешСумма));
		Результат.Вставить("backup_path", ПутьКопии);
		Результат.Вставить("backup_sha256", ХешКопии);
		Результат.Вставить("requires_fresh_session_verification", Истина);
		// Платформа может нормализовать контейнер CFE: хеш выгруженных байтов сообщается отдельно.
		Аудит(Идентификатор, "stored", Аргументы.name, Результат.stored_sha256);
	Исключение
		Описание = Лев(ОписаниеОшибки(), 2048);
		ОсвобождениеПодтверждено = Истина;
		Попытка
			УстановитьМонопольныйРежим(Ложь);
		Исключение
			ОсвобождениеПодтверждено = Ложь;
			Описание = Описание + " Не подтверждено снятие собственного монопольного режима.";
		КонецПопытки;
		ИсходНеизвестен = ЗаписьНачата Или Не ОсвобождениеПодтверждено;
		КодОшибки = ?(ОсвобождениеПодтверждено,
			?(ЗаписьНачата, "write_outcome_unknown", "install_rejected"), "exclusive_release_unknown");
		ОтветОшибки = Новый Структура("operation_id, status, error_code, message, backup_path, backup_sha256",
			Идентификатор, ?(ИсходНеизвестен, "unknown", "rejected"), КодОшибки,
			Описание, ПутьКопии, ХешКопии);
		Возврат Ответ(ОтветОшибки, Истина);
	КонецПопытки;
	Попытка
		УстановитьМонопольныйРежим(Ложь);
	Исключение
		Возврат Ответ(Новый Структура("operation_id, status, error_code, message, backup_path, backup_sha256",
			Идентификатор, "unknown", "exclusive_release_unknown",
			"CFE записан, но снятие собственного монопольного режима не подтверждено. Сначала инспекция.",
			ПутьКопии, ХешКопии), Истина);
	КонецПопытки;
	Возврат Ответ(Результат);

КонецФункции

Функция SHA256(Данные)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));

КонецФункции

Функция ОтпечатокБазы()

	Возврат SHA256(ПолучитьДвоичныеДанныеИзСтроки(СтрокаСоединенияИнформационнойБазы(), КодировкаТекста.UTF8, Ложь));

КонецФункции

Процедура Аудит(Идентификатор, Статус, Имя, Хеш)

	ЗаписьЖурналаРегистрации("mcp.extension_install", УровеньЖурналаРегистрации.Информация, , ,
		mcp_ОбщегоНазначения.СтруктураВJSON(Новый Структура("operation_id, status, name, sha256", Идентификатор, Статус, Имя, Хеш)));

КонецПроцедуры

Функция Ошибка(Код, Сообщение, Идентификатор)

	Возврат Ответ(Новый Структура("operation_id, status, error_code, message", Идентификатор, "failed", Код, Сообщение), Истина);

КонецФункции

Функция Ответ(Данные, ЭтоОшибка = Ложь)

	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type, text", "text", mcp_ОбщегоНазначения.СтруктураВJSON(Данные)));
	Возврат Новый Структура("content, isError", Содержимое, ЭтоОшибка);

КонецФункции

#КонецОбласти
