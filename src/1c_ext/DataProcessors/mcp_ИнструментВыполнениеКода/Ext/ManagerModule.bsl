#Область ПрограммныйИнтерфейс

// Инструмент виден и при выключенном допуске. Каждое выполнение заново проверяет
// серверные настройки: кеш списка инструментов не является проверкой доступа.
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code", "string", "BSL-код до 1000000 символов. Присвойте JSON-совместимое значение переменной Результат.", , Истина));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"parameters", "object", "JSON-объект, доступный коду как Параметры; до 1000000 символов JSON."));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	ОбъектСхемы = mcp_ОбщегоНазначения.JSONВСтруктуру(Схема);
	ОбъектСхемы.properties.code.Вставить("minLength", 1);
	ОбъектСхемы.properties.code.Вставить("maxLength", 1000000);
	ОбъектСхемы.Вставить("additionalProperties", Ложь);
	Схема = mcp_ОбщегоНазначения.СтруктураВJSON(ОбъектСхемы);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "execute_code",
		"Выполнение BSL при наличии роли mcp_ВыполнениеКода. "
		+ "Безопасный режим не включается: действуют права учётной записи вызова, включая запись файлов и привилегированный режим. "
		+ "HTTP timeout не останавливает BSL: после потери ответа не повторяйте вызов автоматически. "
		+ "Результат ограничен 1000000 символами JSON; время, память и побочные эффекты кода не ограничиваются этим инструментом.", Схема);

КонецПроцедуры

// Возвращает готовый MCP CallToolResult, включая isError и execution_id.
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ХешКода = "";
	Если ИмяИнструмента <> "execute_code" Тогда
		Возврат ОтветОшибки(Идентификатор, "unknown_tool", "Неизвестный инструмент.");
	КонецЕсли;

	Попытка
		ЗаписатьАудит(Идентификатор, "requested", Начало, ХешКода);
	Исключение
		Возврат ОтветОшибки(Идентификатор, "audit_unavailable", "Журнал недоступен. Код не выполнялся.");
	КонецПопытки;

	Попытка
		КодОтказа = ПроверитьДопуск();
	Исключение
		КодОтказа = "policy_unavailable";
	КонецПопытки;
	Если КодОтказа <> "" Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, КодОтказа,
			"Выполнение кода не разрешено серверной политикой. Код не выполнялся.", Начало, ХешКода);
	КонецЕсли;

	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_arguments", "Ожидался JSON-объект.", Начало, ХешКода);
	КонецЕсли;
	Код = Неопределено;
	Если НЕ Аргументы.Свойство("code", Код) Или ТипЗнч(Код) <> Тип("Строка") Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_code", "code должен быть строкой.", Начало, ХешКода);
	КонецЕсли;
	Если ПустаяСтрока(Код) Или СтрДлина(Код) > 1000000 Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_code", "Длина code должна быть от 1 до 1000000 символов.", Начало, ХешКода);
	КонецЕсли;
	Для Каждого Аргумент Из Аргументы Цикл
		Если Аргумент.Ключ <> "code" И Аргумент.Ключ <> "parameters" Тогда
			Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_arguments", "Неизвестный параметр.", Начало, ХешКода);
		КонецЕсли;
	КонецЦикла;
	Параметры = Новый Структура;
	Если Аргументы.Свойство("parameters") Тогда
		Параметры = Аргументы.parameters;
	КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_parameters", "parameters должен быть JSON-объектом.", Начало, ХешКода);
	КонецЕсли;
	Попытка
		Если СтрДлина(mcp_ОбщегоНазначения.СтруктураВJSON(Параметры)) > 1000000 Тогда
			Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_parameters", "parameters превышает 1000000 символов JSON.", Начало, ХешКода);
		КонецЕсли;
	Исключение
		Возврат ЗавершитьСОшибкой(Идентификатор, "invalid_parameters", "parameters не сериализуется в JSON.", Начало, ХешКода);
	КонецПопытки;

	Попытка
		ХешКода = SHA256(Код);
		ЗаписатьАудит(Идентификатор, "started", Начало, ХешКода);
	Исключение
		Возврат ОтветОшибки(Идентификатор, "audit_unavailable", "Не удалось зарегистрировать начало. Код не выполнялся.");
	КонецПопытки;

	Попытка
		// Отдельный контекст не передаёт исполняемому коду идентификатор и аудит.
		РезультатJSON = ВыполнитьВБезопасномКонтексте(Код, Параметры);
	Исключение
		// Подробности доступны только вызывающему клиенту, не журналу прокси/1С.
		Возврат ЗавершитьСОшибкой(Идентификатор, "execution_failed",
			Лев(ОписаниеОшибки(), 2048), Начало, ХешКода);
	КонецПопытки;
	Если СтрДлина(РезультатJSON) > 1000000 Тогда
		Возврат ЗавершитьСОшибкой(Идентификатор, "result_too_large",
			"Код выполнен, но результат превышает 1000000 символов JSON. Не повторяйте вызов автоматически.", Начало, ХешКода);
	КонецЕсли;

	Попытка
		ЗаписатьАудит(Идентификатор, "succeeded", Начало, ХешКода);
	Исключение
		Возврат ОтветОшибки(Идентификатор, "audit_unavailable",
			"Код выполнен, но запись результата в журнал не подтверждена. Не повторяйте вызов автоматически.");
	КонецПопытки;
	// JSON результата вставляется без повторной сериализации и без обрезки JSON.
	ТекстОтвета = "{""execution_id"":""" + Идентификатор + """,""status"":""succeeded"",""result"":" + РезультатJSON + "}";
	Возврат ОтветMCP(ТекстОтвета, Ложь);

КонецФункции

// Вызывается администратором в серверной консоли. Через MCP не публикуется.
// Отпечаток следует получить на сервере именно согласованного тестового стенда.
Процедура НастроитьВыполнениеКода(Включить, ОтпечатокСтенда = "") Экспорт

	Если НЕ РольДоступна("mcp_НастройкаВыполненияКода") Тогда
		ВызватьИсключение "Требуется роль настройки выполнения кода.";
	КонецЕсли;
	Если ТипЗнч(Включить) <> Тип("Булево") Тогда
		ВызватьИсключение "Включить должен быть булевым значением.";
	КонецЕсли;
	Если Включить И (ТипЗнч(ОтпечатокСтенда) <> Тип("Строка") Или ОтпечатокСтенда <> ОтпечатокТекущейБазы()) Тогда
		ВызватьИсключение "Отпечаток не соответствует текущему серверному подключению.";
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Настройка допуска требует отдельной транзакции.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Константы.mcp_ВыполнениеКодаРазрешено.Установить(Включить);
		Константы.mcp_ОтпечатокТестовойБазы.Установить(?(Включить, ОтпечатокСтенда, ""));
		ЗаписьЖурналаРегистрации("mcp.execute_code.policy", УровеньЖурналаРегистрации.Информация, , ,
			?(Включить, "enabled", "disabled"));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Не раскрывает строку подключения. Перенос копии на другой адрес снимает допуск.
Функция ОтпечатокТекущейБазы() Экспорт

	Возврат SHA256(СтрокаСоединенияИнформационнойБазы());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьДопуск()

	// Допуск — сама роль. Полные права, роль настройки и константы политики его не отменяют.
	Если НЕ РольДоступна("mcp_ВыполнениеКода") Тогда
		Возврат "role_required";
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Возврат "transaction_active";
	КонецЕсли;
	Возврат "";

КонецФункции

// Безопасный режим не включается: код идёт с правами учётной записи вызова.
// Это не транзакционная песочница: бизнес-код может записывать данные.
Функция ВыполнитьВБезопасномКонтексте(Знач Код, Знач Параметры)

	Результат = Неопределено;
	Попытка
		Выполнить Код;
		// Незавершённую транзакцию не оставляем следующему запросу сеанса.
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
			ВызватьИсключение "Код оставил незавершённую транзакцию. Она отменена; ранее зафиксированные действия могли сохраниться.";
		КонецЕсли;
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция SHA256(Знач Текст)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	Возврат СтрЗаменить(Строка(Хеширование.ХешСумма), " ", "");

КонецФункции

Процедура ЗаписатьАудит(Идентификатор, Статус, Начало, ХешКода)

	Запись = Новый Структура("execution_id, status, elapsed_ms, code_sha256", Идентификатор, Статус,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, ХешКода);
	// Пользователь и сеанс входят в стандартные поля журнала регистрации.
	// Текст кода, параметры, результат, ошибка и строка подключения не записываются.
	ЗаписьЖурналаРегистрации("mcp.execute_code", УровеньЖурналаРегистрации.Информация, , ,
		mcp_ОбщегоНазначения.СтруктураВJSON(Запись));

КонецПроцедуры

Функция ЗавершитьСОшибкой(Идентификатор, КодОшибки, Сообщение, Начало, ХешКода)

	Попытка
		ЗаписатьАудит(Идентификатор, КодОшибки, Начало, ХешКода);
	Исключение
		Возврат ОтветОшибки(Идентификатор, "audit_unavailable",
			"Запись в журнал не подтверждена. Результат действий неизвестен; не повторяйте вызов автоматически.");
	КонецПопытки;
	Возврат ОтветОшибки(Идентификатор, КодОшибки, Сообщение);

КонецФункции

Функция ОтветОшибки(Идентификатор, КодОшибки, Сообщение)

	Результат = Новый Структура("execution_id, status, error_code, message", Идентификатор, "failed", КодОшибки, Сообщение);
	Возврат ОтветMCP(mcp_ОбщегоНазначения.СтруктураВJSON(Результат), Истина);

КонецФункции

Функция ОтветMCP(Текст, ПризнакОшибки)

	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type, text", "text", Текст));
	Возврат Новый Структура("content, isError", Содержимое, ПризнакОшибки);

КонецФункции

#КонецОбласти
