// Только integration fixture. Не переносить этот HTTP-сервис в прикладные конфигурации.
// Нет параметров с BSL, именами ролей, путями или значениями констант от HTTP-клиента.

Процедура ПроверитьИзоляцию()

	Соединение = НРег(СтрокаСоединенияИнформационнойБазы());
	Если Метаданные.Имя <> "ExtensionApiFixture"
		Или СтрНайти(Соединение, "file=") <> 1
		Или СтрНайти(Соединение, "\build\extension-api\isolated-live\") = 0 Тогда
		ВызватьИсключение "fixture_guard: разрешена только собственная одноразовая File ИБ.";
	КонецЕсли;

КонецПроцедуры

Функция Ответ(Статус)

	Результат = Новый HTTPСервисОтвет(200);
	Результат.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Результат.УстановитьТелоИзСтроки(Статус);
	Возврат Результат;

КонецФункции

Процедура СоздатьТестовогоПользователя(Имя, Чтение, Установка)

	Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
	Пользователь.Имя = Имя;
	Пользователь.ПолноеИмя = Имя;
	Пользователь.АутентификацияСтандартная = Истина;
	Пользователь.Пароль = "";
	Пользователь.Роли.Добавить(Метаданные.Роли.FixturePlatformRights);
	Если Чтение Тогда
		Пользователь.Роли.Добавить(Метаданные.Роли.Найти("mcp_ЧтениеРасширений"));
	КонецЕсли;
	Если Установка Тогда
		Пользователь.Роли.Добавить(Метаданные.Роли.Найти("mcp_УстановкаРасширений"));
		Пользователь.Роли.Добавить(Метаданные.Роли.Найти("mcp_НастройкаУстановкиРасширений"));
	КонецЕсли;
	Пользователь.Записать();

КонецПроцедуры

Функция bootstrapPOST(Запрос)

	ПроверитьИзоляцию();
	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() <> 0 Тогда
		ВызватьИсключение "fixture_guard: bootstrap допускается только при пустом списке пользователей.";
	КонецЕсли;
	СоздатьТестовогоПользователя("FixtureOperator", Истина, Истина);
	СоздатьТестовогоПользователя("FixtureProbe", Истина, Ложь);
	СоздатьТестовогоПользователя("FixtureDenied", Ложь, Ложь);
	Возврат Ответ("fixture_users_created; installation remains disabled");

КонецФункции

Функция enablePOST(Запрос)

	ПроверитьИзоляцию();
	Если ИмяПользователя() <> "FixtureOperator" Тогда
		ВызватьИсключение "fixture_guard: только FixtureOperator.";
	КонецЕсли;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(СтрокаСоединенияИнформационнойБазы(), КодировкаТекста.UTF8, Ложь));
	Отпечаток = НРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));
	Каталог = КаталогВременныхФайлов() + "mcp-extension-api-fixture-" + Отпечаток;
	СоздатьКаталог(Каталог);
	Константы["mcp_УстановкаРасширенийРазрешена"].Установить(Ложь);
	Константы["mcp_СтендУстановкиРасширений"].Установить(Отпечаток);
	Константы["mcp_КаталогКопийРасширений"].Установить(Каталог);
	Константы["mcp_УстановкаРасширенийРазрешена"].Установить(Истина);
	Возврат Ответ("fixture_installation_enabled");

КонецФункции

Функция disablePOST(Запрос)

	ПроверитьИзоляцию();
	Если ИмяПользователя() <> "FixtureOperator" Тогда
		ВызватьИсключение "fixture_guard: только FixtureOperator.";
	КонецЕсли;
	Константы["mcp_УстановкаРасширенийРазрешена"].Установить(Ложь);
	Возврат Ответ("fixture_installation_disabled");

КонецФункции

Функция fileAccessPOST(Запрос)

	ПроверитьИзоляцию();
	Если ИмяПользователя() <> "FixtureOperator" Тогда
		ВызватьИсключение "fixture_guard: только FixtureOperator.";
	КонецЕсли;
	// Отдельное явное действие только на собственной пустой fixture ИБ.
	// В реальных базах безопасный режим/профиль MCP настраивает администратор вручную.
	Список = РасширенияКонфигурации.Получить(Новый Структура("Имя", "mcp_tools"));
	Если Список.Количество() <> 1 Тогда
		ВызватьИсключение "fixture_guard: ожидается ровно одно mcp_tools.";
	КонецЕсли;
	Расширение = Список[0];
	Данные = Расширение.ПолучитьДанные();
	Расширение.БезопасныйРежим = Ложь;
	// Это настройка только административного MCP этой одноразовой fixture.
	// Без неё подключение MCP вне safe mode требует интерактивного диалога 1С.
	Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
	Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	Расширение.ЗащитаОтОпасныхДействий = Защита;
	Расширение.Записать(Данные);
	Возврат Ответ("fixture_mcp_file_access_enabled; new service session required");

КонецФункции
